---
import Layout from '../layouts/Layout.astro'
import ComparisonApp from '../components/ComparisonApp.vue'
---

<Layout>
  <header class="hero">
    <h1>SurveyJS v3 × Astro</h1>
    <p>
      Integration stress test: SurveyJS Form Library in an Astro + Vue islands app,
      side by side with a native Vue wizard. SurveyJS mounts client-only via
      <code>client:only="vue"</code>.
    </p>
  </header>

  <ComparisonApp client:only="vue" />
</Layout>
