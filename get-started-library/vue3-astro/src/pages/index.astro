---
import Layout from '../layouts/Layout.astro'
import ComparisonApp from '../components/ComparisonApp.vue'
---

<Layout>
  <header class="hero">
    <h1>SurveyJS v3 × Astro</h1>
    <p>
      SurveyJS Form Library in an Astro + Vue islands app, side by side with a
      native Vue wizard. The Vue island is server-rendered and hydrated via
      <code>client:load</code>.
    </p>
  </header>

  <ComparisonApp client:load />
</Layout>
